flowchart TB
    subgraph DRONE["ON DRONE -- student bundle under 512 KB, under 20 ms"]
        direction TB
        L1["L1 PERCEPT (fixed-point; one C99 lib, three call sites; norm.h frozen)<br/>ring buffers to EWMA / CUSUM / run-length histograms<br/>S1..S10 passive discriminative stats to feature vector<br/>plus CUSUM anomaly gate"]
        L2["L2 AGENT (~1 Hz)<br/>classifier to belief (8 + unknown)<br/>test planner (expected info-gain per cost)<br/>policy head (validated lookup + learned corrections)"]
        SAFE["SAFETY ENVELOPE<br/>logit masking, then monotone escalation ladder, then dead-man failsafe.c<br/>(runs even if inference hangs)"]
    end
    L0["L0 RADIO (classical, unchanged): MAC / PHY / ARQ / OLSRv1"]
    subgraph OFF["OFFLINE (lab)"]
        direction TB
        TEA["Teacher (LLM)<br/>self-consistency k=5 + rejection sampling (test-selection only)"]
