        EXP["int8 export, then int8-equivalence gate (argmax agree at least 99.5 percent)"]
    end
    NS3["ns-3 world + oracle + FIDELITY GATE (fading marginals match barrage)"]
    VER["Verifier: predicates + FPR_acted + censored latency + paired-bootstrap CI"]

